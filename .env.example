# ─── Core (required for auth + app shell) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ─── OAuth state signing for Google/Autodesk integrations ───────────
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset
OAUTH_STATE_SECRET=

# ─── Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@5bloc.com

# ─── AI (Anthropic) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── File storage (Cloudflare R2) ───────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=5bloc-documents
R2_PUBLIC_URL=

# ─── Google Workspace integration ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# ─── Autodesk / APS ─────────────────────────────────────────────────
AUTODESK_CLIENT_ID=
AUTODESK_CLIENT_SECRET=

# ─── Payments ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_PLAN_SOLO=
RAZORPAY_PLAN_TEAM=
RAZORPAY_PLAN_BADGE=
RAZORPAY_PLAN_AI=
# Signs /pay/… links in invoice emails (falls back to RAZORPAY_KEY_SECRET or service role)
PAYMENT_LINK_SECRET=

# ─── Cron (meeting reminders) ───────────────────────────────────────
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/meeting-reminders
CRON_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Smoke / demo ───────────────────────────────────────────────────
# NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
# Leave ENABLE_SMOKE_ADMIN unset so /admin test logins stay on.
# Set ENABLE_SMOKE_ADMIN=0 only when you are ready to hide /admin.
# Leave PAYWALL_ENFORCED unset during the test release (all paid features included).
# For production billing: PAYWALL_ENFORCED=1 and NEXT_PUBLIC_PAYWALL_ENFORCED=1
MOCK_AUTH=0
NEXT_PUBLIC_MOCK_AUTH=0
